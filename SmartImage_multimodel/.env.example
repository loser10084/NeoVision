# API / LLM settings
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# Segmentation model settings
SEG_MODEL_DIR=./segmentation_model
SEG_WEIGHTS_PATH=./segmentation_model/best_lightweight_unet.pth
SEG_DEVICE=cpu
SEG_LABEL_CLASS=1
SEG_MODALITY_DIR=./segmentation_model/data

# CTV refine/expand settings
CTV_MODEL_DIR=./segmentation_model
CTV_PYTHON=
CTV_REFINE_SCRIPT=
CTV_EXPAND_SCRIPT=
CTV_UNET_CKPT=
CTV_REFINE_CKPT=
CTV_DEVICE=
CTV_EXPANSION_MM=1
CTV_SPACING_MM=
CTV_CONF_SCRIPT=
CTV_CONF_SLICE_INDEX=80
CTV_CONF_NORMALIZE=true

# Model settings
MODEL_NAME=gpt-4o-mini
IMAGE_MODEL_NAME=gpt-5-mini
EMBEDDING_MODEL_NAME=text-embedding-3-small
MODEL_TEMPERATURE=0.2
MODEL_TIMEOUT=60

# Prompt files
SYSTEM_PROMPT_PATH=./system_prompt.md
IMAGE_SYSTEM_PROMPT_PATH=./image_system_prompt.md

# Runtime settings
MODEL_PORT=5001
MODEL_DEBUG=false
SHOW_TOOL_CALLS=true
DEBUG_MODE=false

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RAG settings
RAG_PERSIST_DIR=./data_storage/RAG/chroma_db
RAG_COLLECTION=zhiying_rag_demo
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.25

# Chat history settings
CHAT_HISTORY_TTL_SECONDS=3600
CHAT_HISTORY_MAX_TOKENS=1200

# CPDM CT -> PET settings
CPDM_ROOT_DIR=./cpdm_model/CPDM-main
CPDM_PYTHON=python
CPDM_TEMPLATE_CONFIG=./cpdm_model/CPDM-main/configs/Template-CPDM-local-one.yaml
CPDM_MODEL_CKPT=./cpdm_weights/CPDM_latest_model_200.pth
CPDM_VQGAN_CKPT=./cpdm_weights/VQGAN_1_3_69.ckpt
CPDM_UNET_CKPT=./cpdm_weights/UNET_AttentionMap_step_9000.ckpt
CPDM_GPU_IDS=-1
CPDM_SAMPLE_STEP=200
CPDM_TIMEOUT_SECONDS=1800
CPDM_MPLCONFIGDIR=./cpdm_model/CPDM-main/.mplconfig
CPDM_KEEP_JOB_DIR=false

# Model output storage policy
# - oss/backend/backend_oss: upload model outputs through backend API into OSS
# - local: keep model outputs on local disk
MODEL_OUTPUT_STORAGE=oss
BACKEND_API_BASE_URL=http://127.0.0.1:8080
BACKEND_UPLOAD_TIMEOUT_SECONDS=120
BACKEND_SERVICE_BEARER_TOKEN=
