# Example environment variables for SmartImage_backend.
# Spring Boot does not auto-load this file by default.
# Export these values in your shell / IDE run configuration before starting services.

# Service ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8082
PATIENT_SERVICE_PORT=8083
STUDY_SERVICE_PORT=8084

# Service registration
SERVICE_BIND_IP=127.0.0.1
NACOS_SERVER_ADDR=127.0.0.1:8848

# Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=smart_image
MYSQL_USERNAME=root
MYSQL_PASSWORD=change_me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# OSS
ALIOSS_ACCESS_KEY_ID=
ALIOSS_ACCESS_KEY_SECRET=
ALIOSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIOSS_BUCKET_NAME=

# Downstream model service
MODEL_SERVICE_BASE_URL=http://127.0.0.1:5001
