# Example environment variables for MasterImage_frontend.
# These values are used at build time. After installation, gateway/model
# URLs can still be overridden from the in-app service settings page.

VUE_APP_GATEWAY_URL=http://127.0.0.1:8080
VUE_APP_AUTH_URL=
VUE_APP_PATIENT_URL=
VUE_APP_STUDY_URL=
VUE_APP_MODEL_URL=http://127.0.0.1:5001
